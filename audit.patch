+                a.W_range_v.copy_(a.W_range_v[perm])
+                a.W_range_f.copy_(a.W_range_f[perm])
+                for lin in (a.W_gate_k, a.W_gate_v, a.W_gate_sal,
+                            a.W_gate_f, a.W_gate_d, a.W_qtemp):
+                    lin.weight.copy_(lin.weight[perm])
