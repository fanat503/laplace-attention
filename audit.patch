+                Pv = a.c_proj.weight.view(C, H, hd)
+                a.c_proj.weight.copy_(Pv[:, perm, :].reshape(C, C))
+                a.W_phase_q.copy_(a.W_phase_q[perm])
+                a.W_phase_k.copy_(a.W_phase_k[perm])
